#pragma once

// Canonical application version. This header is generated by CMake from the
// single source of truth: `project(misuc VERSION x.y.z ...)` in the top-level
// CMakeLists.txt. All version display (About dialog, splash, window title,
// package name, desktop metadata) derives from MISUC_VERSION_STRING.
//
// Do not edit this file by hand; it is regenerated by CMake on every configure.

#define MISUC_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define MISUC_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define MISUC_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define MISUC_VERSION_STRING "@PROJECT_VERSION@"