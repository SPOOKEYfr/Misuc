// Windows shell identity for misuc_app: the Explorer/taskbar/alt-tab icon
// comes from this resource (the Qt window icon alone does not cover the shell
// surface). Version fields are stamped from CMake at configure time so the
// installer/updater surfaces agree with the project() version.
1 ICON "@MISUC_RC_ICON_PATH@"

1 VERSIONINFO
FILEVERSION     @MISUC_RC_FILEVER_Q@
PRODUCTVERSION  @MISUC_RC_FILEVER_Q@
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Misuc"
      VALUE "FileDescription",  "Misuc - Multi-track MIDI sequencer and audio workstation"
      VALUE "FileVersion",      "@MISUC_RC_FILEVER_S@"
      VALUE "InternalName",     "misuc_app"
      VALUE "LegalCopyright",   "GPL-3.0-or-later"
      VALUE "OriginalFilename", "misuc_app.exe"
      VALUE "ProductName",      "Misuc"
      VALUE "ProductVersion",   "@MISUC_RC_FILEVER_S@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04b0 // US-English + Unicode
  END
END
